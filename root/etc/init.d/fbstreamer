#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/fbstreamer
PORT=9999

start_service() {
	[ -x "" ] || return 1
	
	if [ -f /root/enable_hdmi.sh ]; then
		/root/enable_hdmi.sh > /dev/null 2>&1
	fi

	procd_open_instance
	procd_set_param command "" ""
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	killall -9 fbstreamer 2>/dev/null
}
